<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_bridge</name>
  <version>0.0.1</version>
  <description>Bridges the Unitree G1's raw DDS /lowstate into sensor_msgs/JointState for RViz/robot_state_publisher</description>
  <maintainer email="unitree@unitree.com">unitree-g1-experiments</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>unitree_hg</depend>
  <depend>unitree_go</depend>
  <depend>python3-opencv</depend>
  <depend>python3-matplotlib</depend>
  <!-- mujoco (mujoco_mirror.py) and pymodbus (inspire_hand_modbus_bridge.py)
       have no rosdep/apt key, so they are installed via pip in
       docker/Dockerfile instead of declared here. -->

  <exec_depend>g1_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
