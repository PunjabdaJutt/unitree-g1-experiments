# g1-depth-relay.service -- optional systemd unit for depth_relay_onboard.py.
#
# Not required for manual testing (just run `python3 depth_relay_onboard.py`
# directly) -- use this once the pipeline is validated and you want it to
# survive reboots/crashes without being started by hand.
#
# Install (on the onboard Jetson, from inside this directory):
#   sudo cp g1-depth-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now g1-depth-relay.service
#
# Logs:
#   journalctl -u g1-depth-relay.service -f
#
# If this directory is not at /home/unitree/g1_depth_bridge, edit
# WorkingDirectory/ExecStart below to match before installing.

[Unit]
Description=G1 D435i depth camera DDS relay
After=network.target

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree/g1_depth_bridge
ExecStart=/usr/bin/python3 /home/unitree/g1_depth_bridge/depth_relay_onboard.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
